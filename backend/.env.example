# Referência para variáveis locais do terminal ou da IDE.
# Spring Boot não carrega este arquivo .env automaticamente.
ORACLE_JDBC_URL=jdbc:oracle:thin:@//SEU_HOST:1521/SEU_SERVICO
ORACLE_DB_USER=SEU_USUARIO
ORACLE_DB_PASSWORD=SUA_SENHA
TZ=America/Sao_Paulo

# Conta opcional de desenvolvimento, desabilitada por padrão.
# Ao habilitar, forneça e-mail e senha somente no seu ambiente local.
CAIXU_TEST_USER_ENABLED=false
CAIXU_TEST_USER_EMAIL=
CAIXU_TEST_USER_PASSWORD=
